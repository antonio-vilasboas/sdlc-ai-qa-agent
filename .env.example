# Atlassian Cloud (Jira & Confluence REST API) — mesmas credenciais para ambos
ATLASSIAN_BASE_URL="https://o-teu-dominio.atlassian.net"
ATLASSIAN_USER_EMAIL="o-teu-email@exemplo.com"
ATLASSIAN_API_TOKEN="o-teu-api-token"
JIRA_PROJECT_KEY="PROJ"
CONFLUENCE_SPACE_KEY="QA"

# Xray Cloud (OAuth2 client credentials) — Jira > Apps > Xray > Settings > API Keys
XRAY_CLIENT_ID="o-teu-xray-client-id"
XRAY_CLIENT_SECRET="o-teu-xray-client-secret"
# XRAY_BASE_URL="https://xray.cloud.getxray.app"   # opcional (região EU: https://eu.xray.cloud.getxray.app)

# LLM — Anthropic Claude via LiteLLM (prefixo obrigatório "anthropic/")
ANTHROPIC_API_KEY="sk-ant-..."
LLM_MODEL="anthropic/claude-haiku-4-5-20251001"
